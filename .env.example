# Copy to .env and set a NEW private password before first startup.
# Existing database passwords do not change when this file changes.
POSTGRES_USER=merlin
POSTGRES_DB=merlin_db
POSTGRES_PASSWORD=

# Original project/storage remain merlin unless you explicitly override them.
MERLIN_PROJECT_NAME=merlin
MERLIN_NETWORK_NAME=merlin-network
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# Local auth API runtime. Set only after applying migration 003 to a guarded
# disposable/development database and provisioning the merlin_api role password.
MERLIN_DATABASE_DSN=
MERLIN_REDIS_URL=redis://127.0.0.1:6379/0
MERLIN_AUTH_SIGNING_KEY_B64=
MERLIN_AUTH_VERIFICATION_KEY_B64=
MERLIN_RATE_LIMIT_KEY_B64=
